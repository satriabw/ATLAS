# CallMeBot WhatsApp notifications
# 1. Save this as .env (never commit .env)
# 2. Add the CallMeBot number on WhatsApp: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 3. Send "I allow callmebot to send me messages" to get your apikey

CALLMEBOT_PHONE=628123456789   # international format, no +
CALLMEBOT_APIKEY=your_apikey_here

# WandB experiment tracking
# Get your key at https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here
